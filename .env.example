# Copia este fichero a .env.local y rellena los valores (nunca subas .env.local a git).

# Supabase (públicas: llegan al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio (metadatos, enlaces en emails)
NEXT_PUBLIC_SITE_URL=

# Solo servidor / scripts: Supabase → Connect → Transaction pooler (puerto 6543)
DATABASE_URL=
# Session pooler (puerto 5432): para restaurar backups con pg_restore
DATABASE_URL_SESSION=
# Solo scripts locales (pnpm db:upload-storage): Supabase → Project Settings → API Keys → Secret keys.
# Salta la RLS: jamás se usa en src/, nunca lleva NEXT_PUBLIC_ y nunca se sube al repo ni a Vercel.
SUPABASE_SECRET_KEY=

# IA del chatbot
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=

# Correo (nodemailer)
CORREO_HOST=
CORREO_PORT=
CORREO_USUARIO=
CORREO_PASS=
